<view class="game-page">
  <canvas id="campus" type="2d" class="campus-canvas" bindtouchstart="mapTouch" disable-scroll></canvas>
  <view class="top-shade"></view>
  <view class="game-header">
    <view class="brand"><view class="brand-seal">梧</view><view><view class="brand-title">青梧大学</view><view class="brand-sub">CAMPUS LIFE</view></view></view>
    <view class="week-pill"><text class="week-dot"></text>{{semesterName}} · 第 {{weekLabel}} / 4 周</view>
    <view class="header-button" bindtap="openGuide">?</view>
  </view>

  <view class="status-card">
    <view class="profile-row"><view class="profile-avatar" style="background:{{character.color}}">{{characterInitial}}</view><view class="profile-info"><text class="profile-name">{{character.name}}</text><text class="profile-title">{{character.title}}</text></view><view class="energy"><text>精力</text><text class="energy-value">{{energy}}</text></view></view>
    <view class="energy-track"><view style="width:{{energy}}%"></view></view>
    <view class="stats-row"><view wx:for="{{statsArray}}" wx:key="key" class="stat-chip"><text class="stat-icon" style="color:{{item.color}}">{{item.icon}}</text><text>{{item.name}}</text><text class="stat-number">{{item.value}}</text></view></view>
  </view>

  <view class="quest-card"><view class="quest-label">大学四年 · 目标</view><view class="quest-text">探索 8 个场景 × 16 段故事，读完八个学期</view><view class="quest-progress"><view style="width:{{progress}}%"></view></view><view class="quest-meta"><text>第 {{semester}} / 8 学期</text><text>{{progress}}%</text></view></view>

  <view wx:if="{{nearby && !modal}}" class="location-toast"><text class="location-pin">⌖</text><view><text class="location-name">{{nearby.name}}</text><text class="location-tip">点击右下角，查看可接任务</text></view></view>

  <view class="joystick" bindtouchstart="joyStart" bindtouchmove="joyMove" bindtouchend="joyEnd" bindtouchcancel="joyEnd"><view class="joy-ring"></view><view class="joy-arrows">⌃</view><view class="joy-knob" style="transform:translate({{joyX}}px,{{joyY}}px)"></view></view>
  <view class="action-area"><button class="action-button {{nearby ? 'active' : ''}}" bindtap="interact"><text class="action-icon">{{nearby ? '✦' : '＋'}}</text><text>{{nearby ? (nearby.type === 'npc' ? '聊一聊' : '进入') : '探索'}}</text></button><view class="action-tip">走近发光入口</view></view>
  <button wx:if="{{examReady && !modal}}" class="exam-button" bindtap="showExamIntro">{{examSemesterName || semesterName}}期末考 · 进入考试 →</button>

  <view wx:if="{{modal}}" class="modal-mask {{modal === 'scene' || modal === 'quest' || modal === 'reply' ? 'story-mask scene-mode' : ''}}">
    <canvas wx:if="{{modal === 'scene' || modal === 'quest' || modal === 'reply'}}" id="scene-full-art" type="2d" class="scene-full-art"></canvas>

    <view wx:if="{{modal === 'scene'}}" class="story-panel scene-panel">
      <view class="story-visual" style="background:linear-gradient(130deg,{{scene.art.sky[0]}},{{scene.art.sky[1]}})"><view class="story-place">{{scene.place}}</view><view class="scene-title-over">{{scene.name}}</view><view class="story-lines"></view></view>
      <view class="story-content">
        <view class="story-kicker">SCENE · {{semesterName}}</view>
        <view class="story-title">{{scene.name}} · 可接任务</view>
        <view class="speaker-row"><view class="speaker-avatar" style="background:{{scene.color}}">{{scene.avatar}}</view><view><view class="speaker-name">{{scene.speaker}}</view><view class="speaker-role">{{scene.role}}</view></view></view>
        <view class="quest-list">
          <button wx:for="{{sceneProgress}}" wx:key="index" class="quest-item {{item.done ? 'done' : ''}}" data-index="{{item.index}}" bindtap="chooseQuest">
            <text class="quest-badge">{{item.done ? '✓ 已完成' : '任务 '}}{{item.done ? '' : item.index + 1}}</text>
            <view class="quest-mid"><text class="quest-name">{{item.quest.title}}</text><text class="quest-meta-line">{{item.done && item.times > 1 ? '已重复 ' + (item.times - 1) + ' 次 · 收益递减' : item.done ? '可重温 · 收益递减' : item.quest.choices.length + ' 个选择'}}</text></view>
            <text class="quest-arrow">›</text>
          </button>
        </view>
        <view class="story-footer">每次任务消耗 1 周；每学期 4 周，期末后进入下一学期</view>
      </view>
    </view>

    <view wx:if="{{modal === 'quest'}}" class="story-panel">
      <view class="story-visual" style="background:linear-gradient(130deg,{{scene.art.sky[0]}},{{scene.art.sky[1]}})"><view class="story-place">{{scene.place}}</view><view class="story-symbol">{{scene.avatar}}</view><view class="story-lines"></view></view>
      <view class="story-content">
        <view class="story-kicker">CAMPUS STORY · {{questDone ? 'REPLAY' : 'NEW'}} · {{semesterName}} 第{{weekLabel}}周</view>
        <view class="story-title">{{quest.title}}</view>
        <view class="speaker-row"><view class="speaker-avatar" style="background:{{scene.color}}">{{scene.avatar}}</view><view><view class="speaker-name">{{scene.speaker}}</view><view class="speaker-role">{{scene.role}}</view></view></view>
        <view class="story-text">{{quest.text}}</view>
        <view class="choices">
          <button wx:for="{{quest.choices}}" wx:key="index" class="choice" data-index="{{index}}" bindtap="chooseStory"><view class="choice-index">{{index + 1}}</view><view class="choice-body"><view>{{item.text}}</view><view class="choice-hint">{{item.hint}}{{questDone ? ' · 重温收益递减' : ''}}</view></view><text class="choice-arrow">›</text></button>
        </view>
        <view class="story-footer">选择没有标准答案，它会塑造独一无二的你</view>
      </view>
    </view>

    <view wx:if="{{modal === 'reply'}}" class="reply-panel">
      <view class="choice-reaction {{reaction.isDefault ? 'default' : reaction.tone}}"><view class="reaction-emoji">{{reaction.emotion}}</view><view class="reaction-bubble">{{reaction.bubble}}</view></view>
      <view class="reply-kicker">故事已收入图鉴</view><view class="reply-title">{{quest.title}}</view><view class="reply-text">{{reply}}</view>
      <view wx:if="{{echo}}" class="echo-card"><view class="echo-label">旧选择的回响</view><view class="echo-text">{{echo.text}}</view><view class="echo-origin">最初发生于 {{echo.selectedAt.label}}</view></view>
      <view class="effect-list"><view wx:for="{{effects}}" wx:key="key" class="effect-item {{item.value >= 0 ? 'positive' : 'negative'}}">{{item.name}} {{item.value >= 0 ? '+' : ''}}{{item.value}}</view></view><button class="primary-button" bindtap="closeReply">继续校园生活 →</button>
    </view>

    <view wx:if="{{modal === 'guide'}}" class="small-panel"><view class="panel-close" bindtap="closeModal">×</view><view class="panel-kicker">NEW STUDENT HANDBOOK</view><view class="panel-title">新生校园指南</view>
      <view class="guide-item"><text>01</text><view><text class="guide-bold">四年八学期</text><text class="guide-para">8 个学期覆盖完整大学四年。每学期 4 周行动 + 1 次期末考；每个场景有 2 个可接任务。</text></view></view>
      <view class="guide-item"><text>02</text><view><text class="guide-bold">自由探索</text><text class="guide-para">拖动摇杆或点击地面寻路。走近建筑入口与 NPC 即可进入场景接任务。</text></view></view>
      <view class="guide-item"><text>03</text><view><text class="guide-bold">做出选择</text><text class="guide-para">16 个任务各有多个选项。重复完成仍有收益，但属性成长会递减。</text></view></view>
      <view class="guide-item"><text>04</text><view><text class="guide-bold">照顾自己</text><text class="guide-para">行动消耗精力，每周恢复 10 点（江野 +8）。期末后假期会大幅恢复。</text></view></view>
      <view class="guide-item"><text>05</text><view><text class="guide-bold">迎接毕业</text><text class="guide-para">每学期期末考 5 道情境题 + 日常成长计分。大四下学期结束后，根据四年积累走向毕业结局。</text></view></view>
      <button class="secondary-button" bindtap="closeModal">我准备好了</button><button class="text-button" bindtap="restart">重新选择角色</button>
    </view>

    <view wx:if="{{modal === 'examIntro'}}" class="small-panel exam-intro"><view class="exam-emblem">末</view><view class="panel-kicker">FINAL EXAMINATION</view><view class="panel-title">{{examSemesterName}} · 期末考试</view><view class="exam-desc">{{isFinal ? '这是大学生涯的最后一场考试。' : '一学期的探索与选择，都将成为此刻的底气。'}}共 5 道情境题，日常学识与实践也会影响成绩。</view><view class="exam-rule"><text>答题正确</text><text class="exam-points">50 分</text><text>日常成长</text><text class="exam-points">50 分</text></view><button class="primary-button" bindtap="startExam">开始作答</button></view>

    <view wx:if="{{modal === 'exam'}}" class="small-panel exam-panel"><view class="exam-progress-head"><text>第 {{semester}} 学期期末考</text><text>{{examIndex + 1}} / 5</text></view><view class="exam-progress-track"><view style="width:{{(examIndex + 1) * 20}}%"></view></view><view class="exam-question">{{currentQuestion.question}}</view><view class="exam-options"><button wx:for="{{currentQuestion.options}}" wx:key="index" data-index="{{index}}" bindtap="answerExam"><text>{{item}}</text><text>›</text></button></view><view class="exam-note">请凭直觉作答，大学里的经验会帮助你的成绩</view></view>

    <view wx:if="{{modal === 'semester'}}" class="small-panel"><view class="exam-emblem" style="border-color:#7d9275;color:#5f7a5f">假</view><view class="panel-kicker">SEMESTER COMPLETE</view><view class="panel-title">{{semesterResult.semesterName}} 结束</view><view class="score-ring"><text>{{semesterResult.score}}</text><text class="score-label">期末成绩</text></view><view class="exam-desc">假期里你好好休整了一番，精力大幅恢复。接下来是 {{nextSemesterName}}。</view><view class="exam-rule"><text>答对</text><text class="exam-points">{{semesterResult.correct}} / 5 题</text><text>已完成学期</text><text class="exam-points">{{semester}} / 8</text></view><button class="primary-button" bindtap="nextSemester">进入{{nextSemesterName}} →</button></view>

    <view wx:if="{{modal === 'ending'}}" class="ending-panel"><view class="ending-kicker">GRADUATION · 四年旅程结束</view><view class="ending-seal" style="border-color:{{ending.color}};color:{{ending.color}}">梧</view><view class="ending-tag">{{ending.tag}}</view><view class="ending-title">{{ending.title}}</view><view class="score-ring"><text>{{ending.score}}</text><text class="score-label">四年平均成绩</text></view><view class="ending-text">{{ending.text}}</view><view class="ending-stats"><view wx:for="{{statsArray}}" wx:key="key"><text>{{item.name}}</text><text class="ending-value">{{item.value}}</text></view></view><view class="ending-quote">“大学不是一张标准答卷，而是一段允许试错的路。”</view><button class="primary-button" bindtap="restart">开启另一种人生</button></view>
  </view>
</view>

