.game-page { width: 100vw; height: 100vh; overflow: hidden; position: relative; background: #cbdcb6; }
.campus-canvas { width: 100%; height: 100%; display: block; touch-action: none; }
.top-shade { position: absolute; pointer-events: none; top: 0; left: 0; right: 0; height: 330rpx; background: linear-gradient(180deg,rgba(242,240,220,.92),rgba(247,243,225,.42),transparent); }
.game-header { position: absolute; top: calc(env(safe-area-inset-top) + 20rpx); left: 28rpx; right: 28rpx; display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; gap: 13rpx; }.brand-seal { width: 57rpx; height: 57rpx; border: 2rpx solid #587564; border-radius: 50%; display: flex; align-items: center; justify-content: center; font: bold 30rpx serif; color: #4d6d5b; }.brand-title { font: bold 28rpx "KaiTi",serif; letter-spacing: 4rpx; }.brand-sub { font-size: 11rpx; color: #73887b; letter-spacing: 3rpx; margin-top: 2rpx; }
.week-pill { background: rgba(255,253,241,.85); border: 1rpx solid rgba(78,111,89,.15); border-radius: 28rpx; padding: 13rpx 20rpx; font-size: 21rpx; color: #50695b; box-shadow: 0 4rpx 16rpx rgba(52,77,60,.07); }.week-dot { display: inline-block; width: 10rpx; height: 10rpx; background: #7b9c74; border-radius: 50%; margin-right: 10rpx; }
.header-button { width: 51rpx; height: 51rpx; border-radius: 50%; background: rgba(255,253,241,.85); border: 1rpx solid rgba(78,111,89,.17); font: 26rpx serif; color: #5b7465; text-align: center; line-height: 48rpx; }
.status-card { position: absolute; left: 28rpx; top: calc(env(safe-area-inset-top) + 101rpx); width: 480rpx; max-width: calc(100vw - 56rpx); padding: 18rpx 20rpx 16rpx; background: rgba(255,253,244,.9); backdrop-filter: blur(10px); border: 1rpx solid rgba(255,255,255,.65); border-radius: 18rpx; box-shadow: 0 10rpx 30rpx rgba(54,76,59,.1); }
.profile-row { display: flex; align-items: center; }.profile-avatar { width: 49rpx; height: 49rpx; border-radius: 13rpx; color: white; display: flex; align-items: center; justify-content: center; font: bold 24rpx serif; }.profile-info { display: flex; flex-direction: column; flex: 1; margin-left: 13rpx; }.profile-name { font-size: 24rpx; font-weight: 600; }.profile-title { font-size: 16rpx; color: #8b968c; margin-top: 3rpx; }.energy { display: flex; gap: 7rpx; font-size: 17rpx; color: #8a9287; }.energy-value { color: #a47b43; font-weight: bold; }
.energy-track { height: 5rpx; border-radius: 4rpx; background: #eae6d9; margin: 13rpx 0; overflow: hidden; }.energy-track view { height: 100%; border-radius: 4rpx; background: linear-gradient(90deg,#d7b569,#e9cb7d); transition: width .3s; }
.stats-row { display: flex; justify-content: space-between; }.stat-chip { display: flex; align-items: center; gap: 5rpx; font-size: 16rpx; color: #78857a; }.stat-icon { font: bold 18rpx serif; }.stat-number { font-size: 20rpx; font-weight: 600; color: #41584d; margin-left: 2rpx; }
.quest-card { position: absolute; right: 28rpx; top: calc(env(safe-area-inset-top) + 101rpx); width: 300rpx; padding: 18rpx 20rpx; background: rgba(53,78,64,.88); border-radius: 17rpx; color: #fffbed; box-shadow: 0 10rpx 25rpx rgba(45,69,53,.14); }.quest-label { color: #d4c792; font-size: 16rpx; letter-spacing: 3rpx; }.quest-text { font-size: 19rpx; line-height: 1.5; margin-top: 8rpx; }.quest-progress { height: 5rpx; background: rgba(255,255,255,.16); border-radius: 4rpx; margin-top: 14rpx; overflow: hidden; }.quest-progress view { height: 100%; background: #e7d18c; }.quest-meta { display: flex; justify-content: space-between; font-size: 14rpx; color: #d3d9cb; margin-top: 7rpx; }
.location-toast { position: absolute; left: 50%; bottom: 250rpx; transform: translateX(-50%); min-width: 320rpx; display: flex; align-items: center; gap: 15rpx; padding: 16rpx 24rpx; border: 0; border-radius: 18rpx; background: rgba(255,253,242,.94); box-shadow: 0 8rpx 30rpx rgba(48,65,50,.17); line-height: 1.2; text-align: left; }.location-pin { font-size: 40rpx; color: #738f74; }.location-toast view { display: flex; flex-direction: column; }.location-name { font-size: 24rpx; font-weight: 600; }.location-tip { font-size: 17rpx; color: #8b9487; margin-top: 4rpx; }
.joystick { position: absolute; left: 45rpx; bottom: calc(env(safe-area-inset-bottom) + 43rpx); width: 174rpx; height: 174rpx; border-radius: 50%; background: rgba(249,247,230,.35); border: 1rpx solid rgba(255,255,255,.45); backdrop-filter: blur(4px); touch-action: none; }.joy-ring { position: absolute; inset: 25rpx; border-radius: 50%; border: 1rpx dashed rgba(60,88,69,.25); }.joy-arrows { position: absolute; left: 75rpx; top: 4rpx; color: rgba(55,81,64,.35); font-size: 25rpx; }.joy-knob { position: absolute; left: 51rpx; top: 51rpx; width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255,254,243,.88); border: 2rpx solid rgba(91,117,91,.25); box-shadow: 0 5rpx 15rpx rgba(50,72,53,.18); }
.action-area { position: absolute; right: 46rpx; bottom: calc(env(safe-area-inset-bottom) + 47rpx); text-align: center; }.action-button { width: 132rpx; height: 132rpx; padding: 0; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(250,247,231,.7); color: #718276; border: 2rpx solid rgba(255,255,255,.55); box-shadow: 0 7rpx 25rpx rgba(48,72,54,.14); font-size: 20rpx; }.action-button.active { color: #fffcec; background: #52745f; border: 5rpx solid rgba(240,231,183,.65); box-shadow: 0 0 0 8rpx rgba(248,241,199,.2),0 8rpx 25rpx rgba(48,72,54,.25); }.action-icon { font-size: 35rpx; line-height: 1.3; }.action-tip { margin-top: 12rpx; color: #4e6959; font-size: 16rpx; text-shadow: 0 1rpx #f7f4df; }
.exam-button { position: absolute; bottom: calc(env(safe-area-inset-bottom) + 48rpx); left: 50%; transform: translateX(-50%); background: #a77545; color: #fff9e8; border-radius: 40rpx; padding: 0 28rpx; height: 70rpx; line-height: 70rpx; font-size: 21rpx; box-shadow: 0 8rpx 25rpx rgba(99,72,40,.25); white-space: nowrap; }
.modal-mask { position: absolute; z-index: 20; inset: 0; background: rgba(30,49,41,.56); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; padding: 30rpx; }.story-mask { background: rgba(29,47,40,.68); }
.story-panel { width: 690rpx; max-height: 91vh; overflow: hidden; border-radius: 28rpx; background: #fffcf3; box-shadow: 0 25rpx 80rpx rgba(19,34,27,.35); }.story-visual { height: 160rpx; position: relative; overflow: hidden; background: linear-gradient(130deg,#819e8a,#b5bea1); }.story-visual::before { content:''; position:absolute; width:280rpx;height:280rpx;border:1rpx solid rgba(255,255,255,.2);border-radius:50%;right:-30rpx;top:-120rpx;box-shadow:0 0 0 35rpx rgba(255,255,255,.04); }.story-place { position: absolute; left: 32rpx; top: 29rpx; color: #f9f7e9; font-size: 19rpx; letter-spacing: 2rpx; }.story-symbol { position:absolute;right:43rpx;bottom:17rpx;font:bold 100rpx "KaiTi",serif;color:rgba(255,252,226,.25); }.story-lines { position:absolute;left:32rpx;bottom:34rpx;width:90rpx;height:2rpx;background:#e3d39f;box-shadow:0 -12rpx rgba(240,231,191,.4),0 12rpx rgba(240,231,191,.4); }
.story-content { padding: 29rpx 32rpx 24rpx; max-height: calc(91vh - 160rpx); overflow-y: auto; }.story-kicker,.panel-kicker { color: #a18e69; font-size: 16rpx; letter-spacing: 3rpx; }.story-title { margin-top: 7rpx; font: bold 37rpx "KaiTi",serif; color: #354e43; }.speaker-row { display: flex; align-items: center; gap: 13rpx; margin: 22rpx 0 17rpx; }.speaker-avatar { width: 57rpx; height: 57rpx; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font: 25rpx serif; border: 3rpx solid #eee7d7; }.speaker-name { font-size: 22rpx; font-weight: 600; }.speaker-role { color: #92978c; font-size: 16rpx; margin-top: 4rpx; }.story-text { font-size: 22rpx; color: #606b62; line-height: 1.85; text-align: justify; }
.choices { display: flex; flex-direction: column; gap: 12rpx; margin-top: 24rpx; }.choice { padding: 16rpx 15rpx; margin: 0; background: #f6f2e8; border: 1rpx solid #e9e2d2; border-radius: 14rpx; display: flex; align-items: center; text-align: left; line-height: 1.4; }.choice.button-hover { background: #e9eee3; border-color: #9cac95; }.choice-index { flex: 0 0 auto; width: 37rpx; height: 37rpx; border-radius: 50%; background: #e3e5d9; display: flex; align-items: center; justify-content: center; color: #72816f; font: 19rpx serif; margin-right: 13rpx; }.choice-body { flex: 1; font-size: 20rpx; color: #43564b; }.choice-hint { margin-top: 7rpx; color: #9a896e; font-size: 16rpx; }.choice-arrow { font-size: 32rpx; color: #9aa28f; margin-left: 8rpx; }.story-footer { text-align: center; color: #a3a396; font-size: 16rpx; margin-top: 20rpx; }
.reply-panel,.small-panel,.ending-panel { position: relative; width: 620rpx; max-height: 90vh; overflow-y: auto; padding: 42rpx 38rpx 34rpx; border-radius: 27rpx; background: #fffcf3; box-shadow: 0 25rpx 80rpx rgba(19,34,27,.35); text-align: center; }.reply-spark { width: 75rpx; height: 75rpx; margin: 0 auto 18rpx; border-radius: 50%; background: #e9eddf; color: #7b9473; font-size: 38rpx; display: flex; align-items: center; justify-content: center; }.reply-kicker { color: #9c8e72; font-size: 17rpx; letter-spacing: 5rpx; }.reply-title { font: bold 36rpx "KaiTi",serif; margin-top: 10rpx; }.reply-text { margin: 25rpx 0; color: #667067; font-size: 22rpx; line-height: 1.9; text-align: left; }.effect-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; margin-bottom: 27rpx; }.effect-item { padding: 9rpx 16rpx; border-radius: 22rpx; font-size: 19rpx; }.effect-item.positive { background: #e8efdf; color: #63815e; }.effect-item.negative { background: #f3e5dc; color: #b37962; }
.primary-button,.secondary-button { height: 78rpx; line-height: 78rpx; border-radius: 15rpx; font-size: 23rpx; }.primary-button { background: #4f715e; color: #fffdf1; box-shadow: 0 7rpx 18rpx rgba(57,89,67,.17); }.secondary-button { background: #e7ecdf; color: #58705d; margin-top: 20rpx; }.text-button { background: transparent; color: #949789; font-size: 19rpx; margin-top: 12rpx; }.panel-close { position: absolute; top: 19rpx; right: 23rpx; color: #899388; font-size: 40rpx; }.panel-title { font: bold 38rpx "KaiTi",serif; margin: 9rpx 0 25rpx; }.guide-item { display: flex; gap: 18rpx; text-align: left; margin: 22rpx 0; }.guide-item>text { flex: 0 0 auto; color: #b7a77d; font: 25rpx serif; }.guide-bold { display: block; font-size: 23rpx; font-weight: bold; color: #465e50; }.guide-para { display: block; margin: 6rpx 0 0; font-size: 20rpx; line-height: 1.7; color: #7e867c; }
.exam-emblem { width: 95rpx; height: 95rpx; margin: 0 auto 25rpx; border: 2rpx solid #a3845c; border-radius: 50%; color: #96734d; display: flex; align-items: center; justify-content: center; font: 46rpx "KaiTi",serif; }.exam-desc { font-size: 21rpx; line-height: 1.8; color: #7b8379; }.exam-rule { margin: 25rpx 0; padding: 20rpx; background: #f4f0e5; border-radius: 15rpx; display: flex; justify-content: space-around; align-items: center; }.exam-rule text { color: #8b8c7e; font-size: 18rpx; }.exam-points { color: #9b774d; font-size: 23rpx; font-weight: bold; }
.exam-progress-head { display: flex; justify-content: space-between; color: #7b887c; font-size: 20rpx; }.exam-progress-track { height: 7rpx; background: #ebe8dc; border-radius: 4rpx; margin: 16rpx 0 30rpx; overflow: hidden; }.exam-progress-track view { height: 100%; background: #789176; }.exam-question { min-height: 120rpx; text-align: left; font-size: 27rpx; line-height: 1.65; color: #40574a; font-weight: 600; }.exam-options { display: flex; flex-direction: column; gap: 13rpx; margin-top: 20rpx; }.exam-options button { display: flex; justify-content: space-between; margin: 0; padding: 20rpx 22rpx; background: #f5f2e9; border: 1rpx solid #e5e1d3; border-radius: 13rpx; font-size: 21rpx; color: #5f6d62; text-align: left; line-height: 1.4; }.exam-options button.button-hover { background: #e5ecdf; }.exam-note { margin-top: 25rpx; font-size: 16rpx; color: #a1a195; }
.ending-panel { overflow: hidden auto; }.ending-rays { position: absolute; width: 500rpx; height: 500rpx; left: calc(50% - 250rpx); top: -250rpx; border-radius: 50%; background: repeating-conic-gradient(rgba(202,185,125,.09) 0deg 10deg,transparent 10deg 25deg); }.ending-kicker { position: relative; font-size: 15rpx; letter-spacing: 3rpx; color: #a19477; }.ending-seal { position: relative; width: 88rpx; height: 88rpx; margin: 21rpx auto 13rpx; border: 2rpx solid; border-radius: 50%; display: flex; align-items: center; justify-content: center; font: 44rpx "KaiTi",serif; }.ending-tag { display: inline-block; padding: 7rpx 17rpx; border-radius: 20rpx; background: #ede8d9; color: #8c7c5d; font-size: 17rpx; letter-spacing: 3rpx; }.ending-title { font: bold 38rpx "KaiTi",serif; margin: 14rpx 0; }.score-ring { width: 130rpx; height: 130rpx; border-radius: 50%; border: 5rpx solid #d5c695; outline: 1rpx solid #e6dec3; outline-offset: 5rpx; margin: 21rpx auto; display: flex; flex-direction: column; align-items: center; justify-content: center; }.score-ring text { font: bold 47rpx serif; color: #8f7447; }.score-ring .score-label { color: #9b9989; font-size: 15rpx; }.ending-text { font-size: 21rpx; line-height: 1.85; color: #6f796e; text-align: left; }.ending-stats { display: flex; justify-content: space-around; padding: 18rpx 0; border-top: 1rpx solid #e9e4d7; border-bottom: 1rpx solid #e9e4d7; margin: 22rpx 0; }.ending-stats view { display: flex; flex-direction: column; gap: 7rpx; }.ending-stats text { color: #94978b; font-size: 16rpx; }.ending-stats .ending-value { color: #516859; font-size: 24rpx; font-weight: bold; }.ending-quote { color: #a28f70; font: 19rpx "KaiTi",serif; margin-bottom: 23rpx; }
@media (max-width: 600px) { .quest-card { display:none; }.week-pill { font-size:18rpx;padding:12rpx; }.brand-sub { display:none; }.status-card { top:calc(env(safe-area-inset-top) + 94rpx); }.game-header { left:20rpx;right:20rpx; }.story-panel { width:100%; }.modal-mask { padding:20rpx; }.small-panel,.reply-panel,.ending-panel { width:100%; }.exam-button { bottom:calc(env(safe-area-inset-bottom) + 220rpx); } }

.scene-art-wrap{padding:0}
.scene-art-wrap canvas{position:absolute;left:0;top:0;width:100%;height:100%;display:block}
.scene-title-over{position:absolute;left:32rpx;bottom:36rpx;color:#fffdf0;font:bold 30rpx "KaiTi",serif;letter-spacing:6rpx;text-shadow:0 2rpx 12rpx rgba(0,0,0,.35)}
.quest-list{display:flex;flex-direction:column;gap:12rpx;margin-top:24rpx}
.quest-item{display:flex;align-items:center;margin:0;padding:20rpx 22rpx;background:#f6f2e8;border:1rpx solid #e9e2d2;border-radius:14rpx;text-align:left}
.quest-item.button-hover{background:#eef1e5}
.quest-item.done{background:#f0eee4}
.quest-badge{flex:0 0 auto;font-size:19rpx;padding:8rpx 16rpx;border-radius:20rpx;background:#e3e5d9;color:#72816f;margin-right:18rpx}
.quest-item.done .quest-badge{background:#d8e2cf;color:#5f7a5f}
.quest-mid{flex:1;display:flex;flex-direction:column}
.quest-name{font-size:23rpx;font-weight:600;color:#43564b}
.quest-meta-line{font-size:18rpx;color:#9a896e;margin-top:6rpx}
.quest-arrow{font-size:38rpx;color:#9aa28f;margin-left:12rpx}

/* 全屏场景背景 */
.modal-mask.scene-mode{background:transparent;backdrop-filter:none}
.scene-full-art{position:absolute;left:0;top:0;width:100%;height:100%;z-index:1}
.scene-mode .story-panel,.scene-mode .reply-panel{position:relative;z-index:2;margin:auto;box-shadow:0 30rpx 90rpx rgba(10,18,26,.5)}
