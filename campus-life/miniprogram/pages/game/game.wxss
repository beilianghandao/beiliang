.game-page { width: 100vw; height: 100vh; overflow: hidden; position: relative; background: #cbdcb6; }
.campus-canvas { width: 100%; height: 100%; display: block; touch-action: none; }
.top-shade { position: absolute; pointer-events: none; top: 0; left: 0; right: 0; height: 330rpx; background: linear-gradient(180deg,rgba(242,240,220,.92),rgba(247,243,225,.42),transparent); }
.game-header { position: absolute; top: calc(env(safe-area-inset-top) + 20rpx); left: 28rpx; right: 28rpx; display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; gap: 13rpx; }.brand-seal { width: 57rpx; height: 57rpx; border: 2rpx solid #587564; border-radius: 50%; display: flex; align-items: center; justify-content: center; font: bold 30rpx serif; color: #4d6d5b; }.brand-title { font: bold 28rpx "KaiTi",serif; letter-spacing: 4rpx; }.brand-sub { font-size: 11rpx; color: #73887b; letter-spacing: 3rpx; margin-top: 2rpx; }
.week-pill { background: rgba(255,253,241,.85); border: 1rpx solid rgba(78,111,89,.15); border-radius: 28rpx; padding: 13rpx 20rpx; font-size: 21rpx; color: #50695b; box-shadow: 0 4rpx 16rpx rgba(52,77,60,.07); }.week-dot { display: inline-block; width: 10rpx; height: 10rpx; background: #7b9c74; border-radius: 50%; margin-right: 10rpx; }
.header-button { width: 51rpx; height: 51rpx; border-radius: 50%; background: rgba(255,253,241,.85); border: 1rpx solid rgba(78,111,89,.17); font: 26rpx serif; color: #5b7465; text-align: center; line-height: 48rpx; }
.status-card { position: absolute; left: 28rpx; top: calc(env(safe-area-inset-top) + 101rpx); width: 480rpx; max-width: calc(100vw - 56rpx); padding: 18rpx 20rpx 16rpx; background: rgba(255,253,244,.9); backdrop-filter: blur(10px); border: 1rpx solid rgba(255,255,255,.65); border-radius: 18rpx; box-shadow: 0 10rpx 30rpx rgba(54,76,59,.1); }
.profile-row { display: flex; align-items: center; }.profile-avatar { width: 49rpx; height: 49rpx; border-radius: 13rpx; color: white; display: flex; align-items: center; justify-content: center; font: bold 24rpx serif; }.profile-info { display: flex; flex-direction: column; flex: 1; margin-left: 13rpx; }.profile-name { font-size: 24rpx; font-weight: 600; }.profile-title { font-size: 16rpx; color: #8b968c; margin-top: 3rpx; }.energy { display: flex; gap: 7rpx; font-size: 17rpx; color: #8a9287; }.energy-value { color: #a47b43; font-weight: bold; }
.energy-track { height: 5rpx; border-radius: 4rpx; background: #eae6d9; margin: 13rpx 0; overflow: hidden; }.energy-track view { height: 100%; border-radius: 4rpx; background: linear-gradient(90deg,#d7b569,#e9cb7d); transition: width .3s; }
.stats-row { display: flex; justify-content: space-between; }.stat-chip { display: flex; align-items: center; gap: 5rpx; font-size: 16rpx; color: #78857a; }.stat-icon { font: bold 18rpx serif; }.stat-number { font-size: 20rpx; font-weight: 600; color: #41584d; margin-left: 2rpx; }
.quest-card { position: absolute; right: 28rpx; top: calc(env(safe-area-inset-top) + 101rpx); width: 300rpx; padding: 18rpx 20rpx; background: rgba(53,78,64,.88); border-radius: 17rpx; color: #fffbed; box-shadow: 0 10rpx 25rpx rgba(45,69,53,.14); }.quest-label { color: #d4c792; font-size: 16rpx; letter-spacing: 3rpx; }.quest-text { font-size: 19rpx; line-height: 1.5; margin-top: 8rpx; }.quest-progress { height: 5rpx; background: rgba(255,255,255,.16); border-radius: 4rpx; margin-top: 14rpx; overflow: hidden; }.quest-progress view { height: 100%; background: #e7d18c; }.quest-meta { display: flex; justify-content: space-between; font-size: 14rpx; color: #d3d9cb; margin-top: 7rpx; }
.location-toast { position: absolute; left: 50%; bottom: 250rpx; transform: translateX(-50%); display: flex; align-items: center; gap: 18rpx; padding: 14rpx 26rpx 14rpx 14rpx; border-radius: 34rpx; background: linear-gradient(180deg, rgba(255,253,245,.98), rgba(251,244,228,.96)); box-shadow: 0 22rpx 46rpx -16rpx rgba(44,58,46,.45), 0 4rpx 12rpx rgba(44,58,46,.1), inset 0 0 0 2rpx rgba(255,255,255,.85); }.location-pin { flex: none; display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 22rpx; font-size: 30rpx; color: #4f7358; background: linear-gradient(160deg,#eef4e2,#dde8c9); }.location-toast view { display: flex; flex-direction: column; }.location-name { font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; line-height: 1.2; color: #26423a; }.location-tip { font-size: 22rpx; color: #8c9486; margin-top: 6rpx; letter-spacing: .5rpx; }.location-toast::after { content: ''; flex: none; width: 10rpx; height: 10rpx; margin-left: 6rpx; border-right: 4rpx solid #a3ad9a; border-top: 4rpx solid #a3ad9a; transform: rotate(45deg); }
.joystick { position: absolute; left: 45rpx; bottom: calc(env(safe-area-inset-bottom) + 43rpx); width: 174rpx; height: 174rpx; border-radius: 50%; background: rgba(249,247,230,.35); border: 1rpx solid rgba(255,255,255,.45); backdrop-filter: blur(4px); touch-action: none; }.joy-ring { position: absolute; inset: 25rpx; border-radius: 50%; border: 1rpx dashed rgba(60,88,69,.25); }.joy-arrows { position: absolute; left: 75rpx; top: 4rpx; color: rgba(55,81,64,.35); font-size: 25rpx; }.joy-knob { position: absolute; left: 51rpx; top: 51rpx; width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255,254,243,.88); border: 2rpx solid rgba(91,117,91,.25); box-shadow: 0 5rpx 15rpx rgba(50,72,53,.18); }
.action-area { position: absolute; right: 46rpx; bottom: calc(env(safe-area-inset-bottom) + 47rpx); text-align: center; }.action-button { width: 132rpx; height: 132rpx; padding: 0; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(250,247,231,.7); color: #718276; border: 2rpx solid rgba(255,255,255,.55); box-shadow: 0 7rpx 25rpx rgba(48,72,54,.14); font-size: 20rpx; }.action-button.active { color: #fffcec; background: #52745f; border: 5rpx solid rgba(240,231,183,.65); box-shadow: 0 0 0 8rpx rgba(248,241,199,.2),0 8rpx 25rpx rgba(48,72,54,.25); }.action-icon { font-size: 35rpx; line-height: 1.3; }.action-tip { margin-top: 12rpx; color: #4e6959; font-size: 16rpx; text-shadow: 0 1rpx #f7f4df; }
.exam-button { position: absolute; bottom: calc(env(safe-area-inset-bottom) + 48rpx); left: 50%; transform: translateX(-50%); background: #a77545; color: #fff9e8; border-radius: 40rpx; padding: 0 28rpx; height: 70rpx; line-height: 70rpx; font-size: 21rpx; box-shadow: 0 8rpx 25rpx rgba(99,72,40,.25); white-space: nowrap; }
.modal-mask { position: absolute; z-index: 20; inset: 0; background: rgba(30,49,41,.56); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; padding: 30rpx; }.story-mask { background: rgba(29,47,40,.68); }
.story-panel { width: 690rpx; max-height: 91vh; overflow: hidden; border-radius: 28rpx; background: #fffcf3; box-shadow: 0 25rpx 80rpx rgba(19,34,27,.35); }.story-visual { height: 160rpx; position: relative; overflow: hidden; background: linear-gradient(130deg,#819e8a,#b5bea1); }.story-visual::before { content:''; position:absolute; width:280rpx;height:280rpx;border:1rpx solid rgba(255,255,255,.2);border-radius:50%;right:-30rpx;top:-120rpx;box-shadow:0 0 0 35rpx rgba(255,255,255,.04); }.story-place { position: absolute; left: 32rpx; top: 29rpx; color: #f9f7e9; font-size: 19rpx; letter-spacing: 2rpx; }.story-symbol { position:absolute;right:43rpx;bottom:17rpx;font:bold 100rpx "KaiTi",serif;color:rgba(255,252,226,.25); }.story-lines { position:absolute;left:32rpx;bottom:34rpx;width:90rpx;height:2rpx;background:#e3d39f;box-shadow:0 -12rpx rgba(240,231,191,.4),0 12rpx rgba(240,231,191,.4); }
.story-content { padding: 29rpx 32rpx 24rpx; max-height: calc(91vh - 160rpx); overflow-y: auto; }.story-kicker,.panel-kicker { color: #a18e69; font-size: 16rpx; letter-spacing: 3rpx; }.story-title { margin-top: 7rpx; font: bold 37rpx "KaiTi",serif; color: #354e43; }.speaker-row { display: flex; align-items: center; gap: 13rpx; margin: 22rpx 0 17rpx; }.speaker-avatar { width: 57rpx; height: 57rpx; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font: 25rpx serif; border: 3rpx solid #eee7d7; }.speaker-name { font-size: 22rpx; font-weight: 600; }.speaker-role { color: #92978c; font-size: 16rpx; margin-top: 4rpx; }.story-text { font-size: 22rpx; color: #606b62; line-height: 1.85; text-align: justify; }
.choices { display: flex; flex-direction: column; gap: 12rpx; margin-top: 24rpx; }.choice { padding: 16rpx 15rpx; margin: 0; background: #f6f2e8; border: 1rpx solid #e9e2d2; border-radius: 14rpx; display: flex; align-items: center; text-align: left; line-height: 1.4; }.choice.button-hover { background: #e9eee3; border-color: #9cac95; }.choice-index { flex: 0 0 auto; width: 37rpx; height: 37rpx; border-radius: 50%; background: #e3e5d9; display: flex; align-items: center; justify-content: center; color: #72816f; font: 19rpx serif; margin-right: 13rpx; }.choice-body { flex: 1; font-size: 20rpx; color: #43564b; }.choice-hint { margin-top: 7rpx; color: #9a896e; font-size: 16rpx; }.choice-arrow { font-size: 32rpx; color: #9aa28f; margin-left: 8rpx; }.story-footer { text-align: center; color: #a3a396; font-size: 16rpx; margin-top: 20rpx; }
.reply-panel,.small-panel,.ending-panel { position: relative; width: 620rpx; max-height: 90vh; overflow-y: auto; padding: 42rpx 38rpx 34rpx; border-radius: 27rpx; background: #fffcf3; box-shadow: 0 25rpx 80rpx rgba(19,34,27,.35); text-align: center; }.reply-spark { width: 75rpx; height: 75rpx; margin: 0 auto 18rpx; border-radius: 50%; background: #e9eddf; color: #7b9473; font-size: 38rpx; display: flex; align-items: center; justify-content: center; }.reply-kicker { color: #9c8e72; font-size: 17rpx; letter-spacing: 5rpx; }.reply-title { font: bold 36rpx "KaiTi",serif; margin-top: 10rpx; }.reply-text { margin: 25rpx 0; color: #667067; font-size: 22rpx; line-height: 1.9; text-align: left; }.effect-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; margin-bottom: 27rpx; }.effect-item { padding: 9rpx 16rpx; border-radius: 22rpx; font-size: 19rpx; }.effect-item.positive { background: #e8efdf; color: #63815e; }.effect-item.negative { background: #f3e5dc; color: #b37962; }
.primary-button,.secondary-button { height: 78rpx; line-height: 78rpx; border-radius: 15rpx; font-size: 23rpx; }.primary-button { background: #4f715e; color: #fffdf1; box-shadow: 0 7rpx 18rpx rgba(57,89,67,.17); }.secondary-button { background: #e7ecdf; color: #58705d; margin-top: 20rpx; }.text-button { background: transparent; color: #949789; font-size: 19rpx; margin-top: 12rpx; }.panel-close { position: absolute; top: 19rpx; right: 23rpx; color: #899388; font-size: 40rpx; }.panel-title { font: bold 38rpx "KaiTi",serif; margin: 9rpx 0 25rpx; }.guide-item { display: flex; gap: 18rpx; text-align: left; margin: 22rpx 0; }.guide-item>text { flex: 0 0 auto; color: #b7a77d; font: 25rpx serif; }.guide-bold { display: block; font-size: 23rpx; font-weight: bold; color: #465e50; }.guide-para { display: block; margin: 6rpx 0 0; font-size: 20rpx; line-height: 1.7; color: #7e867c; }
.exam-emblem { width: 95rpx; height: 95rpx; margin: 0 auto 25rpx; border: 2rpx solid #a3845c; border-radius: 50%; color: #96734d; display: flex; align-items: center; justify-content: center; font: 46rpx "KaiTi",serif; }.exam-desc { font-size: 21rpx; line-height: 1.8; color: #7b8379; }.exam-rule { margin: 25rpx 0; padding: 20rpx; background: #f4f0e5; border-radius: 15rpx; display: flex; justify-content: space-around; align-items: center; }.exam-rule text { color: #8b8c7e; font-size: 18rpx; }.exam-points { color: #9b774d; font-size: 23rpx; font-weight: bold; }
.exam-progress-head { display: flex; justify-content: space-between; color: #7b887c; font-size: 20rpx; }.exam-progress-track { height: 7rpx; background: #ebe8dc; border-radius: 4rpx; margin: 16rpx 0 30rpx; overflow: hidden; }.exam-progress-track view { height: 100%; background: #789176; }.exam-question { min-height: 120rpx; text-align: left; font-size: 27rpx; line-height: 1.65; color: #40574a; font-weight: 600; }.exam-options { display: flex; flex-direction: column; gap: 13rpx; margin-top: 20rpx; }.exam-options button { display: flex; justify-content: space-between; margin: 0; padding: 20rpx 22rpx; background: #f5f2e9; border: 1rpx solid #e5e1d3; border-radius: 13rpx; font-size: 21rpx; color: #5f6d62; text-align: left; line-height: 1.4; }.exam-options button.button-hover { background: #e5ecdf; }.exam-note { margin-top: 25rpx; font-size: 16rpx; color: #a1a195; }
.ending-panel { overflow: hidden auto; }.ending-rays { position: absolute; width: 500rpx; height: 500rpx; left: calc(50% - 250rpx); top: -250rpx; border-radius: 50%; background: repeating-conic-gradient(rgba(202,185,125,.09) 0deg 10deg,transparent 10deg 25deg); }.ending-kicker { position: relative; font-size: 15rpx; letter-spacing: 3rpx; color: #a19477; }.ending-seal { position: relative; width: 88rpx; height: 88rpx; margin: 21rpx auto 13rpx; border: 2rpx solid; border-radius: 50%; display: flex; align-items: center; justify-content: center; font: 44rpx "KaiTi",serif; }.ending-tag { display: inline-block; padding: 7rpx 17rpx; border-radius: 20rpx; background: #ede8d9; color: #8c7c5d; font-size: 17rpx; letter-spacing: 3rpx; }.ending-title { font: bold 38rpx "KaiTi",serif; margin: 14rpx 0; }.score-ring { width: 130rpx; height: 130rpx; border-radius: 50%; border: 5rpx solid #d5c695; outline: 1rpx solid #e6dec3; outline-offset: 5rpx; margin: 21rpx auto; display: flex; flex-direction: column; align-items: center; justify-content: center; }.score-ring text { font: bold 47rpx serif; color: #8f7447; }.score-ring .score-label { color: #9b9989; font-size: 15rpx; }.ending-text { font-size: 21rpx; line-height: 1.85; color: #6f796e; text-align: left; }.ending-stats { display: flex; justify-content: space-around; padding: 18rpx 0; border-top: 1rpx solid #e9e4d7; border-bottom: 1rpx solid #e9e4d7; margin: 22rpx 0; }.ending-stats view { display: flex; flex-direction: column; gap: 7rpx; }.ending-stats text { color: #94978b; font-size: 16rpx; }.ending-stats .ending-value { color: #516859; font-size: 24rpx; font-weight: bold; }.ending-quote { color: #a28f70; font: 19rpx "KaiTi",serif; margin-bottom: 23rpx; }
@media (max-width: 600px) { .quest-card { display:none; }.week-pill { font-size:18rpx;padding:12rpx; }.brand-sub { display:none; }.status-card { top:calc(env(safe-area-inset-top) + 94rpx); }.game-header { left:20rpx;right:20rpx; }.story-panel { width:100%; }.modal-mask { padding:20rpx; }.small-panel,.reply-panel,.ending-panel { width:100%; }.exam-button { bottom:calc(env(safe-area-inset-bottom) + 220rpx); } }

.scene-art-wrap{padding:0}
.scene-art-wrap canvas{position:absolute;left:0;top:0;width:100%;height:100%;display:block}
.scene-title-over{position:absolute;left:32rpx;bottom:36rpx;color:#fffdf0;font:bold 30rpx "KaiTi",serif;letter-spacing:6rpx;text-shadow:0 2rpx 12rpx rgba(0,0,0,.35)}
.quest-list{display:flex;flex-direction:column;gap:12rpx;margin-top:24rpx}
.quest-item{display:flex;align-items:center;margin:0;padding:20rpx 22rpx;background:#f6f2e8;border:1rpx solid #e9e2d2;border-radius:14rpx;text-align:left}
.quest-item.button-hover{background:#eef1e5}
.quest-item.done{background:#f0eee4}
.quest-badge{flex:0 0 auto;font-size:19rpx;padding:8rpx 16rpx;border-radius:20rpx;background:#e3e5d9;color:#72816f;margin-right:18rpx}
.quest-item.done .quest-badge{background:#d8e2cf;color:#5f7a5f}
.quest-mid{flex:1;display:flex;flex-direction:column}
.quest-name{font-size:23rpx;font-weight:600;color:#43564b}
.quest-meta-line{font-size:18rpx;color:#9a896e;margin-top:6rpx}
.quest-arrow{font-size:38rpx;color:#9aa28f;margin-left:12rpx}

/* ===== 请求事件 / 连锁事件 ===== */
.header-actions{display:flex;align-items:center;gap:12rpx}
.event-button{position:relative;font-size:28rpx}
.event-badge{position:absolute;top:-8rpx;right:-10rpx;min-width:28rpx;height:28rpx;padding:0 7rpx;border-radius:14rpx;background:#c4694f;color:#fff;font-size:16rpx;line-height:28rpx;text-align:center;box-shadow:0 3rpx 9rpx rgba(0,0,0,.25)}
.toast{position:absolute;z-index:30;top:calc(env(safe-area-inset-top) + 100rpx);left:50%;transform:translateX(-50%);display:flex;flex-direction:column;gap:5rpx;padding:18rpx 28rpx;border-radius:18rpx;background:rgba(255,253,242,.95);border:1rpx solid #e0d3b4;box-shadow:0 12rpx 36rpx rgba(44,65,51,.2)}
.toast-title{font-size:21rpx;font-weight:600;color:#4b6b57}
.toast-detail{font-size:17rpx;color:#8b7f66}
.affinity-chip{margin-left:auto;flex:0 0 auto;padding:8rpx 15rpx;border-radius:20rpx;background:#f2eee2;border:1rpx solid #e2dbc8;color:#8a8574;font-size:15rpx;white-space:nowrap}
.request-item{border-color:#d8b775;background:#fdf5e2}
.request-badge{background:#e8c67f;color:#7a5c1e}
.event-list{display:flex;flex-direction:column;gap:12rpx;margin:8rpx 0 24rpx;text-align:left}
.event-row{display:flex;align-items:center;margin:0;padding:18rpx 20rpx;background:#f6f2e8;border:1rpx solid #e9e2d2;border-radius:14rpx;text-align:left;width:100%}
.event-level{flex:0 0 auto;padding:7rpx 14rpx;border-radius:18rpx;background:#e3e5d9;color:#72816f;font-size:16rpx;margin-right:16rpx}
.event-main{flex:1;display:flex;flex-direction:column;gap:5rpx;min-width:0}
.event-name{font-size:22rpx;font-weight:600;color:#43564b}
.event-sub{font-size:16rpx;color:#9a896e}
.trigger-list{margin:8rpx 0 24rpx;padding:20rpx 22rpx;border-radius:14rpx;background:#f4f0e5;text-align:left}
.trigger-head{font-size:16rpx;letter-spacing:3rpx;color:#a18e69;margin-bottom:13rpx}
.trigger-row{display:flex;justify-content:space-between;gap:16rpx;padding:9rpx 0;font-size:19rpx;color:#5c6a5f}
.trigger-in{color:#b08a5a}

/* 全屏场景背景 */
.modal-mask.scene-mode{background:transparent;backdrop-filter:none}
.scene-full-art{position:absolute;left:0;top:0;width:100%;height:100%;z-index:1}
.scene-mode .story-panel,.scene-mode .reply-panel{position:relative;z-index:2;margin:auto;box-shadow:0 30rpx 90rpx rgba(10,18,26,.5)}

/* 选择日志与种子码 */
.header-right { display: flex; align-items: center; }
.seed-pill { background: rgba(255,253,241,.85); border: 1rpx solid rgba(78,111,89,.15); border-radius: 30rpx; padding: 8rpx 14rpx; font: bold 20rpx "Courier New", monospace; letter-spacing: 2rpx; color: #50695b; margin: 0 12rpx; }
.panel-link { margin-top: 16rpx; text-align: center; font-size: 21rpx; letter-spacing: 2rpx; color: #7c8f7f; text-decoration: underline; }
.log-panel { text-align: left; }
.log-panel .panel-kicker, .log-panel .panel-title { text-align: center; }
.log-list { margin-top: 8rpx; max-height: 46vh; overflow-y: auto; }
.log-entry { padding: 20rpx 0; border-bottom: 1rpx dashed #e0dccd; }
.log-meta { display: flex; justify-content: space-between; font-size: 19rpx; color: #9a896e; }
.log-scene { color: #7f8d7d; }
.log-quest { margin-top: 8rpx; font-size: 24rpx; font-weight: 600; color: #43564b; }
.log-choice { margin-top: 6rpx; font-size: 21rpx; line-height: 1.6; color: #7e867c; }
.log-effects { display: flex; flex-wrap: wrap; align-items: center; margin-top: 12rpx; }
.log-effects .effect-item { margin: 0 8rpx 8rpx 0; }
.log-flag { font-size: 19rpx; color: #9aa28f; }
.log-flag.repeat { color: #b08a4e; }
.log-empty { padding: 40rpx 0; text-align: center; color: #8a9389; font-size: 22rpx; }
.ending-seed { margin-top: 16rpx; font-size: 19rpx; color: #8a9389; }
.ending-seed text { font: bold 24rpx "Courier New", monospace; letter-spacing: 3rpx; color: #4f715e; }

/* ===== 周目继承 / 因果面板 ===== */
.cause-button { position: relative; font-size: 24rpx; }
.cause-badge { position: absolute; top: -8rpx; right: -10rpx; min-width: 28rpx; height: 28rpx; padding: 0 7rpx; border-radius: 14rpx; background: #6d8b74; color: #fff; font-size: 16rpx; line-height: 28rpx; text-align: center; box-shadow: 0 3rpx 9rpx rgba(0,0,0,.2); }
.legacy-chip { margin-top: 14rpx; padding: 10rpx 14rpx; border-radius: 12rpx; background: #f4f0e4; border: 1rpx solid #e6dfcd; font-size: 19rpx; color: #6f7a6d; }
.quest-item.locked-item { background: #f4f2ea; border-style: dashed; }
.quest-item.locked-item .quest-name { color: #a5a597; }
.locked-badge { background: #e5e2d5; color: #9b9887; }
.quest-item.hidden-quest { background: #f7f4fb; border-color: #dfd7ee; }
.quest-item.hidden-quest .quest-badge { background: #e5dff3; color: #6d5f96; }
.reply-cause { margin: 4rpx 0 22rpx; font-size: 19rpx; color: #a1a195; }
.reply-consequence { margin: 0 0 20rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #f6ece2; color: #96694c; font-size: 21rpx; line-height: 1.6; text-align: left; }
.ending-legacy { display: flex; flex-direction: column; gap: 8rpx; margin: 0 0 24rpx; padding: 18rpx 20rpx; border-radius: 14rpx; background: #f3f6ea; border: 1rpx solid #e0e7d3; font-size: 21rpx; color: #6b7c66; }
.ending-legacy-title { font-size: 23rpx; font-weight: 600; color: #4d6b55; }

/* 因果面板 */
.cause-panel { text-align: left; }
.cause-panel .panel-title, .cause-panel .exam-desc { text-align: center; }
.cause-total { color: #4d6b55; font-weight: 600; }
.cause-summary { display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; margin: 18rpx 0 16rpx; }
.cause-hint { font-size: 20rpx; color: #a1a195; }
.cause-legacy { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; padding: 14rpx 18rpx; margin-bottom: 14rpx; border-radius: 14rpx; background: #f6f2e5; border: 1rpx dashed #ddcfae; font-size: 20rpx; color: #6f7a6d; }
.cause-legacy-icon { width: 32rpx; height: 32rpx; border-radius: 10rpx; color: #fffdf4; font-size: 18rpx; text-align: center; line-height: 32rpx; }
.cause-dim { color: #a1a195; }
.cause-hidden { padding: 14rpx 18rpx; margin-bottom: 16rpx; border-radius: 14rpx; background: #f4f1e6; font-size: 20rpx; color: #6f7a6d; }
.cause-tabs { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 16rpx 0 18rpx; }
.cause-tab { padding: 10rpx 18rpx; border-radius: 24rpx; background: #f1eee2; border: 1rpx solid #e6e0cf; font-size: 20rpx; color: #7d877c; }
.cause-tab.active { background: #5b7a65; border-color: #4d6a57; color: #fffdf4; }
.cause-tab-count { margin-left: 8rpx; font-size: 18rpx; color: #a19a84; }
.cause-tab.active .cause-tab-count { color: #dfe9d6; }
.cause-timeline { max-height: 52vh; }
.cause-group { margin-bottom: 22rpx; }
.cause-group-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 10rpx; border-bottom: 1rpx solid #ece6d6; font-family: "KaiTi", serif; font-size: 24rpx; color: #4c6455; letter-spacing: 2rpx; }
.cause-group-count { font-family: sans-serif; font-size: 18rpx; color: #a6a293; letter-spacing: 0; }
.cause-row { margin-top: 12rpx; padding: 16rpx 18rpx; border: 1rpx solid #eee7d7; border-left: 5rpx solid #6d8b74; border-radius: 14rpx; background: #faf7ee; }
.cause-row.cause-request { border-left-color: #ae7b9f; }
.cause-row.cause-chain { border-left-color: #c07a5a; }
.cause-row.cause-hidden { border-left-color: #7b6ba8; background: #f7f4fb; }
.cause-row.cause-exam { border-left-color: #5d7ea8; }
.cause-row.cause-legacy { border-left-color: #ba8b48; background: #fdf8ec; }
.cause-head { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.cause-type { padding: 4rpx 12rpx; border-radius: 12rpx; background: #e6ecdf; color: #6b7f6c; font-size: 17rpx; letter-spacing: 1rpx; }
.cause-row.cause-request .cause-type { background: #f0e6ee; color: #8d6683; }
.cause-row.cause-chain .cause-type { background: #f6e6dd; color: #a06a4f; }
.cause-row.cause-hidden .cause-type { background: #e9e4f5; color: #6b5d94; }
.cause-row.cause-exam .cause-type { background: #e2e9f2; color: #5a7597; }
.cause-row.cause-legacy .cause-type { background: #f4e8ce; color: #96733f; }
.cause-title { font-size: 24rpx; font-weight: 600; color: #42584b; }
.cause-at { margin-left: auto; font-size: 17rpx; color: #a9a597; }
.cause-choice { margin-top: 10rpx; font-size: 22rpx; line-height: 1.6; color: #5f6b62; }
.cause-effects { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.cause-effects .effect-item { font-size: 18rpx; padding: 6rpx 14rpx; }
.cause-link { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; padding: 12rpx 16rpx; border-radius: 12rpx; background: #f4ece2; font-size: 19rpx; color: #8a6a4d; }
.cause-link.fired { background: #eae3d6; color: #8b8371; }
.cause-link-text { flex: 1; }
.cause-link-state { padding: 3rpx 10rpx; border-radius: 10rpx; background: #e2d5c1; color: #8a7959; font-size: 17rpx; }
.cause-link.fired .cause-link-state { background: #dcd6c6; color: #8b8371; }
.cause-note { margin-top: 10rpx; font-size: 19rpx; line-height: 1.5; color: #9b9382; }
.cause-echo { margin-top: 6rpx; padding: 18rpx 20rpx; border-radius: 14rpx; background: #f5f2e7; }
.echo-row { display: flex; flex-direction: column; gap: 4rpx; padding: 10rpx 0; border-top: 1rpx dashed #e2dccb; }
.echo-at { font-size: 17rpx; color: #a6a293; }
.echo-title { font-size: 21rpx; font-weight: 600; color: #5c6a5f; }
.echo-choice { font-size: 19rpx; color: #9c9483; }
.achv-layer { position: fixed; z-index: 40; top: calc(env(safe-area-inset-top) + 20rpx); left: 0; right: 0; display: flex; flex-direction: column; align-items: center; gap: 14rpx; pointer-events: none; }
.achv-toast { position: relative; width: 660rpx; max-width: calc(100vw - 40rpx); background: rgba(255,253,243,.98); border: 1rpx solid #d9c58a; border-radius: 20rpx; box-shadow: 0 26rpx 80rpx rgba(30,46,33,.5); overflow: visible; animation: achv-pop-in .62s cubic-bezier(.2,.9,.3,1.16) both; }
.achv-toast.tier-gold { box-shadow: 0 26rpx 80rpx rgba(30,46,33,.5), 0 0 70rpx rgba(196,151,67,.35); animation-name: achv-pop-in-gold; }
.achv-ribbon { position: relative; padding: 12rpx 26rpx; background: linear-gradient(90deg,#b08d57,#d8b98a 55%,#b08d57); color: #fffdf0; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-radius: 19rpx 19rpx 0 0; overflow: hidden; }
.achv-toast.tier-silver .achv-ribbon { background: linear-gradient(90deg,#7d94ab,#bcccdc 55%,#7d94ab); }
.achv-toast.tier-gold .achv-ribbon { background: linear-gradient(90deg,#b3842e,#f0cf6d 55%,#b3842e); }
.achv-ribbon:after { content: ""; position: absolute; top: 0; bottom: 0; left: -60%; width: 45%; background: linear-gradient(105deg,transparent,rgba(255,255,255,.5),transparent); animation: ribbon-shine 2.2s ease .3s infinite; }
.achv-tag { font-size: 17rpx; letter-spacing: 5rpx; }
.achv-ribbon-title { font: bold 24rpx "KaiTi",serif; letter-spacing: 6rpx; }
.achv-main { display: flex; align-items: center; gap: 22rpx; padding: 22rpx 28rpx; }
.achv-icon { flex: 0 0 auto; width: 76rpx; height: 76rpx; border: 3rpx solid; border-radius: 50%; display: flex; align-items: center; justify-content: center; font: bold 38rpx serif; background: #fffef7; animation: icon-pop .6s cubic-bezier(.2,.9,.3,1.4) .1s both; }
.achv-toast.tier-gold .achv-icon { box-shadow: 0 0 0 8rpx rgba(196,151,67,.1), 0 0 40rpx rgba(196,151,67,.4); animation: icon-pop-glow .6s cubic-bezier(.2,.9,.3,1.4) .1s both; }
.achv-info { flex: 1; min-width: 0; }
.achv-name { font-size: 30rpx; font-weight: 600; color: #3c4f45; }
.achv-desc { font-size: 20rpx; color: #92978c; margin-top: 6rpx; }
.achv-tier { flex: 0 0 auto; padding: 8rpx 18rpx; border-radius: 22rpx; color: #fffdf0; font-size: 19rpx; }
@keyframes achv-pop-in { from { transform: translateY(-150%) scale(.86); opacity: 0; } 60% { transform: translateY(14rpx) scale(1.02); opacity: 1; } to { transform: translateY(0) scale(1); opacity: 1; } }
@keyframes achv-pop-in-gold { from { transform: translateY(-160%) scale(.8) rotate(-1.5deg); opacity: 0; } 55% { transform: translateY(16rpx) scale(1.04) rotate(.6deg); opacity: 1; } to { transform: translateY(0) scale(1) rotate(0); opacity: 1; } }
@keyframes ribbon-shine { 0% { left: -60%; } 55%,100% { left: 120%; } }
@keyframes icon-pop { from { transform: scale(0) rotate(-90deg); } 70% { transform: scale(1.18) rotate(6deg); } to { transform: scale(1) rotate(0); } }
@keyframes icon-pop-glow { from { transform: scale(0) rotate(-90deg); } 70% { transform: scale(1.22) rotate(6deg); } to { transform: scale(1) rotate(0); } }
/* 金级成就粒子彩带 */
.confetti { position: absolute; top: 8rpx; left: 50%; width: 11rpx; height: 17rpx; border-radius: 3rpx; opacity: 0; animation: confetti-fall 1.5s ease-out .35s forwards; pointer-events: none; }
.confetti.c1 { --cx: -300rpx; --cy: 170rpx; background: #c49743; }
.confetti.c2 { --cx: -230rpx; --cy: 215rpx; background: #e3c26f; }
.confetti.c3 { --cx: -160rpx; --cy: 245rpx; background: #a57b9c; }
.confetti.c4 { --cx: -90rpx; --cy: 230rpx; background: #5b9272; }
.confetti.c5 { --cx: -15rpx; --cy: 265rpx; background: #c96b4f; }
.confetti.c6 { --cx: 60rpx; --cy: 230rpx; background: #5d7ea8; }
.confetti.c7 { --cx: 130rpx; --cy: 250rpx; background: #c49743; }
.confetti.c8 { --cx: 200rpx; --cy: 215rpx; background: #e3c26f; }
.confetti.c9 { --cx: 270rpx; --cy: 180rpx; background: #ae7b9f; }
.confetti.c10 { --cx: 340rpx; --cy: 145rpx; background: #b08d57; }
@keyframes confetti-fall { 0% { transform: translate(0,0) rotate(0); opacity: 1; } 100% { transform: translate(var(--cx),var(--cy)) rotate(360deg); opacity: 0; } }
/* 屏幕边缘金光闪烁 */
.achv-flash { position: fixed; z-index: 39; inset: 0; pointer-events: none; opacity: 0; background: radial-gradient(ellipse at center, transparent 46%, rgba(196,151,67,.2) 78%, rgba(196,151,67,.4) 100%); }
.achv-flash.achv-flash-on { animation: screen-flash 1s ease-out; }
.achv-flash.tier-bronze.achv-flash-on { animation-duration: .6s; animation-name: screen-flash-soft; }
.achv-flash.tier-gold { background: radial-gradient(ellipse at center, transparent 38%, rgba(196,151,67,.3) 72%, rgba(227,194,111,.6) 100%); }
@keyframes screen-flash { 0% { opacity: 0; } 18% { opacity: 1; } 100% { opacity: 0; } }
@keyframes screen-flash-soft { 0% { opacity: 0; } 20% { opacity: .6; } 100% { opacity: 0; } }

/* ===== 学期成绩柱状对比 ===== */
.semester-chart { margin: 24rpx 0; padding: 22rpx 26rpx; background: #f4f0e5; border-radius: 18rpx; }
.chart-title { font-size: 18rpx; color: #8b8c7e; letter-spacing: 3rpx; text-align: left; }
.chart-bars { display: flex; align-items: flex-end; gap: 14rpx; height: 168rpx; margin-top: 14rpx; }
.chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 8rpx; min-width: 0; }
.chart-value { font-size: 18rpx; color: #9b9989; }
.chart-bar { display: block; width: 72%; max-width: 40rpx; background: linear-gradient(180deg,#9db98a,#7d9275); border-radius: 6rpx 6rpx 0 0; }
.chart-col.current .chart-bar { background: linear-gradient(180deg,#e3c26f,#c49743); }
.chart-label { font-size: 17rpx; color: #a1a195; }
.chart-caption { text-align: center; font-size: 19rpx; color: #8b8c7e; margin-top: 14rpx; }
.chart-caption.up { color: #63815e; }
.chart-caption.down { color: #b37962; }

/* ===== 期末考倒计时 ===== */
.exam-timer-row { display: flex; align-items: center; gap: 18rpx; margin: 0 0 28rpx; padding: 16rpx 20rpx; background: #f4f0e5; border-radius: 16rpx; }
.exam-timer-label { font-size: 20rpx; color: #8b8c7e; white-space: nowrap; }
.exam-timer-num { font: bold 30rpx "Courier New",monospace; color: #8f7447; min-width: 92rpx; text-align: center; }
.exam-timer-track { flex: 1; height: 9rpx; background: #ebe8dc; border-radius: 6rpx; overflow: hidden; }
.exam-timer-track view { height: 100%; background: linear-gradient(90deg,#d7b569,#e9cb7d); transition: width .12s linear; }
.exam-hurry .exam-timer-num { color: #b3543d; animation: achv-pulse 1s infinite; }
.exam-hurry .exam-timer-track view { background: #c96b4f; }
@keyframes achv-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.12); } }
.exam-timeout-flash .exam-question { animation: achv-shake .5s; color: #b3543d; }
@keyframes achv-shake { 0%,100% { transform: translateX(0); } 20% { transform: translateX(-10rpx); } 40% { transform: translateX(10rpx); } 60% { transform: translateX(-6rpx); } 80% { transform: translateX(6rpx); } }

/* ===== 成就图鉴面板 ===== */
.achv-count { font-size: 17rpx; color: #d4c792; letter-spacing: 2rpx; margin-top: 12rpx; }
.achv-summary { display: flex; align-items: center; gap: 18rpx; margin: 4rpx 0 24rpx; }
.achv-summary-bar { flex: 1; height: 8rpx; background: #ebe8dc; border-radius: 6rpx; overflow: hidden; }
.achv-summary-bar view { height: 100%; background: linear-gradient(90deg,#c49743,#e3c26f); }
.achv-summary text { font-size: 20rpx; color: #8b8c7e; white-space: nowrap; }
.achv-grid { max-height: 700rpx; }
.achv-cell { display: flex; gap: 18rpx; padding: 20rpx; background: #f6f2e8; border: 1rpx solid #e9e2d2; border-radius: 16rpx; opacity: .62; margin-bottom: 16rpx; }
.achv-cell.on { opacity: 1; background: #f3f1e3; border-color: #d8c58a; }
.achv-cell-icon { flex: 0 0 auto; width: 56rpx; height: 56rpx; border: 3rpx solid; border-radius: 50%; display: flex; align-items: center; justify-content: center; font: bold 28rpx serif; background: #fffef7; }
.achv-cell-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.achv-cell-name { font-size: 24rpx; font-weight: 600; color: #43564b; display: flex; justify-content: space-between; align-items: baseline; gap: 10rpx; }
.achv-cell-cat { color: #9a896e; font-size: 17rpx; font-weight: 400; white-space: nowrap; }
.achv-cell-desc { font-size: 19rpx; color: #7e867c; line-height: 1.5; margin-top: 6rpx; }
.achv-cell-bar { height: 6rpx; background: #e6e1d2; border-radius: 5rpx; margin-top: 12rpx; overflow: hidden; }
.achv-cell-bar view { height: 100%; background: #9db98a; }
.achv-cell.on .achv-cell-bar view { background: #c49743; }

/* HUD 计数弹跳 + 结算页新成就汇总 */
.achv-count.bump { animation: count-bump .6s ease; }
@keyframes count-bump { 0%,100% { transform: scale(1); } 30% { transform: scale(1.22); color: #f0cf6d; } }
.semester-achv { margin: 22rpx 0; padding: 22rpx 24rpx; background: linear-gradient(130deg,#f6efdd,#f3e9cf); border: 1rpx solid #e0cf9c; border-radius: 18rpx; }
.semester-achv-title { font-size: 20rpx; color: #9b774d; letter-spacing: 3rpx; }
.semester-achv-chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }
.achv-chip { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 20rpx; border-radius: 24rpx; background: #fffdf3; border: 1rpx solid #e5d8b0; font-size: 21rpx; color: #43564b; animation: achv-pop-in .5s cubic-bezier(.2,.9,.3,1.2) both; }
.achv-chip.tier-gold { border-color: #d8b45c; box-shadow: 0 0 20rpx rgba(196,151,67,.16); }
.achv-chip-icon { font: bold 22rpx serif; }

/* ===== 隐藏成就：虹光飘条 + 虹光闪屏 + 彩色粒子 ===== */
.achv-toast.tier-hidden { background: linear-gradient(135deg,#2a1f45,#3a2a5c); border-color: #b79bff; box-shadow: 0 30rpx 90rpx rgba(27,18,51,.8), 0 0 90rpx rgba(138,107,209,.45), 0 0 160rpx rgba(201,155,255,.3); animation: secret-in .8s cubic-bezier(.2,.9,.25,1.12) both; }
.achv-toast.tier-hidden .achv-ribbon { background: linear-gradient(100deg,#ff7ea8,#ffd76e,#7ef0c4,#7ec8ff,#c99bff,#ff7ea8); background-size: 300% 100%; animation: secret-ribbon-flow 3.2s linear infinite; }
.achv-toast.tier-hidden .achv-tag, .achv-toast.tier-hidden .achv-ribbon-title { color: #2a1d44; }
.achv-toast.tier-hidden .achv-name { color: #fff5d6; }
.achv-toast.tier-hidden .achv-desc { color: #c9bde8; }
.achv-toast.tier-hidden .achv-icon { color: #7a4d0a !important; border-color: #e6cf7a !important; background: radial-gradient(circle at 50% 35%,#fff8dc,#f0dda6); box-shadow: 0 0 0 10rpx rgba(255,255,255,.14), 0 0 50rpx rgba(255,215,110,.55); animation: secret-icon 1.4s ease-in-out infinite; }
.achv-toast.tier-hidden .achv-tier { background: linear-gradient(90deg,#ffe08a,#e3bd63) !important; color: #3a2a10 !important; font-weight: 700; }
.secret-rays { position: absolute; left: 50%; top: 60rpx; width: 520rpx; height: 520rpx; margin-left: -260rpx; border-radius: 50%; opacity: .22; pointer-events: none; background: conic-gradient(from 0deg, rgba(255,215,110,0) 0deg, rgba(255,215,110,.55) 7deg, rgba(255,215,110,0) 15deg, rgba(255,126,168,.55) 38deg, rgba(255,126,168,0) 46deg, rgba(126,200,255,.55) 78deg, rgba(126,200,255,0) 86deg, rgba(126,240,196,.55) 118deg, rgba(126,240,196,0) 126deg, rgba(201,155,255,.55) 158deg, rgba(201,155,255,0) 166deg, rgba(255,215,110,.55) 198deg, rgba(255,215,110,0) 206deg, rgba(255,126,168,.55) 238deg, rgba(255,126,168,0) 246deg, rgba(126,200,255,.55) 278deg, rgba(126,200,255,0) 286deg, rgba(126,240,196,.55) 318deg, rgba(126,240,196,0) 326deg, rgba(201,155,255,.55) 350deg, rgba(201,155,255,0) 360deg); animation: secret-rays-spin 7s linear infinite; }
.confetti.secret-bit { width: 14rpx; height: 14rpx; border-radius: 50%; }
.confetti.secret-bit.s1 { --cx: -320rpx; --cy: 150rpx; background: #ffd76e; }
.confetti.secret-bit.s2 { --cx: -270rpx; --cy: 240rpx; background: #ff9f6e; }
.confetti.secret-bit.s3 { --cx: -220rpx; --cy: 130rpx; background: #ff7ea8; }
.confetti.secret-bit.s4 { --cx: -170rpx; --cy: 290rpx; background: #c99bff; }
.confetti.secret-bit.s5 { --cx: -120rpx; --cy: 200rpx; background: #7ec8ff; }
.confetti.secret-bit.s6 { --cx: -70rpx; --cy: 320rpx; background: #7ef0c4; }
.confetti.secret-bit.s7 { --cx: -20rpx; --cy: 160rpx; background: #e9ff8a; }
.confetti.secret-bit.s8 { --cx: 30rpx; --cy: 280rpx; background: #ffd76e; }
.confetti.secret-bit.s9 { --cx: 80rpx; --cy: 190rpx; background: #ff7ea8; }
.confetti.secret-bit.s10 { --cx: 130rpx; --cy: 310rpx; background: #7ec8ff; }
.confetti.secret-bit.s11 { --cx: 180rpx; --cy: 140rpx; background: #c99bff; }
.confetti.secret-bit.s12 { --cx: 230rpx; --cy: 270rpx; background: #7ef0c4; }
.confetti.secret-bit.s13 { --cx: 280rpx; --cy: 180rpx; background: #ff9f6e; }
.confetti.secret-bit.s14 { --cx: 330rpx; --cy: 120rpx; background: #e9ff8a; }
.confetti.secret-bit.s15 { --cx: 380rpx; --cy: 230rpx; background: #ffd76e; }
.confetti.secret-bit.s16 { --cx: -370rpx; --cy: 90rpx; background: #7ec8ff; }
.confetti.secret-bit.s17 { --cx: 60rpx; --cy: 90rpx; background: #ff7ea8; }
.confetti.secret-bit.s18 { --cx: -60rpx; --cy: 110rpx; background: #c99bff; }
@keyframes secret-ribbon-flow { 0% { background-position: 0% 50%; } 100% { background-position: 300% 50%; } }
@keyframes secret-in { 0% { transform: translateY(-160%) scale(.82) rotate(-2deg); opacity: 0; } 55% { transform: translateY(10rpx) scale(1.04) rotate(.6deg); opacity: 1; } 100% { transform: translateY(0) scale(1) rotate(0); opacity: 1; } }
@keyframes secret-icon { 0%,100% { transform: scale(1) rotate(-4deg); } 50% { transform: scale(1.1) rotate(4deg); } }
@keyframes secret-rays-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
.achv-flash.tier-hidden { background: radial-gradient(ellipse at center, transparent 26%, rgba(201,155,255,.28) 58%, rgba(255,215,110,.55) 86%, rgba(255,126,168,.66) 100%); }
.achv-flash.tier-hidden.achv-flash-on { animation: secret-flash 2.2s ease-out; }
@keyframes secret-flash { 0% { opacity: 0; } 12% { opacity: 1; } 45% { opacity: .32; } 70% { opacity: .88; } 100% { opacity: 0; } }

/* 图鉴中的隐藏成就 */
.achv-hidden-hint { margin: 0 0 20rpx; padding: 16rpx 20rpx; background: #f2edfa; border: 1rpx dashed #cdbcf0; border-radius: 14rpx; font-size: 19rpx; color: #7b6a9e; line-height: 1.6; }
.achv-hidden-num { color: #7c4dff; font-weight: 600; }
.achv-hidden-hint.done { background: #f6efdd; border-color: #e0cf9c; color: #9b774d; }
.achv-cell.secret { background: linear-gradient(135deg,#f7f1ff,#f1ecfa); border-color: #d9c9f2; }
.achv-cell.secret.on { border-color: #b79bff; box-shadow: 0 0 30rpx rgba(138,107,209,.22); opacity: 1; }
.achv-cell.secret.locked { opacity: .88; border-style: dashed; }
.achv-cell.secret.locked .achv-cell-icon { color: #b9a8d8; border-color: #cdbcf0; background: #fbf8ff; animation: secret-q 2.6s ease-in-out infinite; }
.achv-cell.secret.locked .achv-cell-name { color: #8d7fa8; }
.achv-cell.secret.locked .achv-cell-desc { color: #a79bbd; }
@keyframes secret-q { 0%,100% { transform: scale(1); opacity: .72; } 50% { transform: scale(1.08); opacity: 1; } }

.achv-chip.tier-hidden { border-color: #b79bff; background: linear-gradient(120deg,#f4ecff,#efe6ff); color: #6c4fb0; }

/* ===== 成就入口（header 徽按钮） ===== */
.header-button { position: relative; }
.achv-badge { position: absolute; top: -8rpx; right: -10rpx; min-width: 28rpx; height: 28rpx; padding: 0 7rpx; border-radius: 14rpx; background: #b08d57; color: #fff; font-size: 16rpx; line-height: 28rpx; text-align: center; box-shadow: 0 3rpx 9rpx rgba(0,0,0,.2); }
.achv-panel { max-height: 82vh; display: flex; flex-direction: column; }
.achv-panel .achv-grid { flex: 1; min-height: 0; }
