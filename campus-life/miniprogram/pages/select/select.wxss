.select-page { min-height: 100vh; padding: 46rpx 32rpx 60rpx; position: relative; overflow: hidden; background: radial-gradient(circle at 50% 0%, #fffdf4 0, #f6f0e4 48%, #eee8db 100%); }
.sky-deco { position: absolute; border: 1rpx solid rgba(119,145,124,.15); border-radius: 50%; pointer-events: none; }
.cloud-one { width: 300rpx; height: 300rpx; top: -170rpx; left: -120rpx; box-shadow: 0 0 0 40rpx rgba(132,157,129,.03); }
.cloud-two { width: 380rpx; height: 380rpx; top: 140rpx; right: -310rpx; box-shadow: 0 0 0 60rpx rgba(132,157,129,.025); }
.hero { text-align: center; position: relative; }
.eyebrow { display: flex; align-items: center; justify-content: center; gap: 18rpx; color: #8c9a87; font-size: 18rpx; letter-spacing: 5rpx; }
.line { width: 36rpx; height: 1rpx; background: #b5bdab; }
.emblem { margin: 30rpx auto 12rpx; width: 94rpx; height: 94rpx; border: 2rpx solid #718f79; border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative; color: #547361; font-family: serif; font-size: 48rpx; }
.emblem::before { content: ''; position: absolute; inset: 7rpx; border: 1rpx solid #b2bda9; border-radius: 50%; }
.leaf { position: absolute; width: 21rpx; height: 11rpx; background: #88a080; border-radius: 100% 0 100% 0; }
.leaf-a { left: -9rpx; top: 23rpx; transform: rotate(-30deg); }.leaf-b { right: -8rpx; bottom: 21rpx; transform: rotate(150deg); }
.title { font-family: "STKaiti", "KaiTi", serif; font-size: 64rpx; font-weight: bold; letter-spacing: 12rpx; color: #35584c; }
.subtitle { margin-top: 7rpx; color: #9c7453; font-size: 26rpx; letter-spacing: 14rpx; }
.intro { margin-top: 22rpx; color: #839087; font-size: 23rpx; letter-spacing: 1rpx; }
.semester-card { margin: 38rpx 0 34rpx; padding: 22rpx 24rpx; border: 1rpx solid rgba(112,139,116,.18); border-radius: 18rpx; background: rgba(255,255,250,.7); display: flex; align-items: center; box-shadow: 0 8rpx 30rpx rgba(60,83,63,.04); }
.semester-icon { width: 62rpx; height: 62rpx; border-radius: 12rpx; background: #e2e9d9; display: flex; align-items: center; justify-content: center; font: bold 27rpx serif; color: #66816c; }
.semester-info { flex: 1; display: flex; flex-direction: column; margin-left: 20rpx; }.semester-title { font-size: 25rpx; font-weight: 600; }.semester-desc { margin-top: 7rpx; font-size: 19rpx; color: #8a9389; }
.semester-badge { font-size: 19rpx; color: #a87b55; padding: 8rpx 12rpx; background: #f3e8d7; border-radius: 20rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20rpx; font-size: 29rpx; font-weight: 600; }.heading-note { color: #9a9f94; font-size: 19rpx; font-weight: normal; }
.character-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.character-card { position: relative; padding: 16rpx 16rpx 18rpx; background: rgba(255,255,252,.8); border: 2rpx solid transparent; border-radius: 22rpx; box-shadow: 0 8rpx 24rpx rgba(68,78,62,.06); transition: .2s; }
.character-card.selected { border-color: #73917b; background: #fffef8; transform: translateY(-3rpx); box-shadow: 0 12rpx 28rpx rgba(68,98,70,.12); }
.selected-mark { position: absolute; z-index: 4; right: 10rpx; top: 10rpx; width: 34rpx; height: 34rpx; border-radius: 50%; background: #6d8b74; color: white; font-size: 21rpx; text-align: center; line-height: 34rpx; }
.portrait { height: 208rpx; position: relative; overflow: hidden; border-radius: 15rpx; background: #eee9dd; }
.portrait-bg { position: absolute; width: 160rpx; height: 160rpx; border: 1rpx solid rgba(255,255,255,.6); border-radius: 50%; top: 24rpx; left: calc(50% - 80rpx); box-shadow: 0 0 0 20rpx rgba(255,255,255,.1); }
.avatar { position: absolute; width: 150rpx; height: 195rpx; left: calc(50% - 75rpx); bottom: -12rpx; }
.avatar-body { position: absolute; width: 126rpx; height: 90rpx; bottom: 0; left: 12rpx; border-radius: 55rpx 55rpx 8rpx 8rpx; background: var(--theme); box-shadow: inset 0 8rpx rgba(255,255,255,.14), inset -8rpx 0 rgba(0,0,0,.06); }
.avatar-collar { position: absolute; width: 30rpx; height: 20rpx; background: #f4ecdd; left: 48rpx; top: 0; clip-path: polygon(0 0,100% 0,50% 100%); }
.avatar-zip { position: absolute; width: 3rpx; height: 66rpx; background: rgba(255,255,255,.4); left: 61rpx; top: 18rpx; }
.avatar-body::after { content: ''; position: absolute; width: 8rpx; height: 8rpx; border-radius: 50%; background: rgba(255,255,255,.55); left: 59rpx; top: 44rpx; }
.avatar-neck { position: absolute; width: 30rpx; height: 39rpx; background: var(--skin); left: 60rpx; top: 105rpx; border-radius: 10rpx; box-shadow: inset 0 6rpx rgba(180,120,90,.18); }
.avatar-face { position: absolute; width: 88rpx; height: 96rpx; background: var(--skin); left: 31rpx; top: 29rpx; border-radius: 42% 42% 48% 48%; z-index: 2; box-shadow: inset 0 -5rpx rgba(202,137,111,.06); }
.avatar-hair-back { position: absolute; width: 106rpx; height: 119rpx; left: 22rpx; top: 17rpx; border-radius: 50rpx 50rpx 38rpx 38rpx; background: var(--hair); }
.avatar-hair-back.hair-short { height: 76rpx; border-radius: 50rpx 50rpx 30rpx 30rpx; }
.avatar-hair-back.hair-ponytail::after { content:''; position: absolute; right: -14rpx; top: 10rpx; width: 26rpx; height: 84rpx; background: var(--hair); border-radius: 60% 60% 60% 60%; transform: rotate(14deg); }
.avatar-hair-back.hair-messy { border-radius: 48rpx 52rpx 34rpx 40rpx; }
.avatar-hair { position: absolute; z-index: 3; width: 92rpx; height: 50rpx; left: 29rpx; top: 18rpx; border-radius: 48rpx 48rpx 20rpx 20rpx; background: var(--hair); overflow: hidden; }
.avatar-hair.hair-messy { height: 54rpx; border-radius: 60% 40% 40% 60% / 70% 60% 40% 50%; transform: rotate(-3deg); }
.avatar-hair.hair-ponytail { height: 46rpx; }
.hair-shine { position: absolute; width: 34rpx; height: 14rpx; border-radius: 50%; background: rgba(255,255,255,.18); left: 12rpx; top: 7rpx; transform: rotate(-18deg); }
.avatar-fringe { position: absolute; z-index: 3; width: 66rpx; height: 34rpx; left: 36rpx; top: 42rpx; background: var(--hair); border-radius: 0 0 70% 20%; transform: rotate(-8deg); }
.avatar-fringe.hair-short { width: 60rpx; height: 28rpx; border-radius: 0 0 60% 40%; }
.avatar-fringe.hair-messy { width: 72rpx; height: 38rpx; left: 30rpx; border-radius: 0 0 50% 50%; transform: rotate(3deg); }
.avatar-fringe.hair-ponytail { width: 56rpx; left: 44rpx; }
.eye { position: absolute; top: 51rpx; width: 6rpx; height: 8rpx; background: #443a35; border-radius: 50%; }.eye::after { content:''; position: absolute; width: 2rpx; height: 3rpx; background: rgba(255,255,255,.9); border-radius: 50%; right: 1rpx; top: 1rpx; }.eye.left { left: 22rpx; }.eye.right { right: 22rpx; }.mouth { position: absolute; width: 15rpx; height: 7rpx; border-bottom: 2rpx solid #b7776b; border-radius: 50%; left: 37rpx; top: 70rpx; }
.blush { position: absolute; top: 62rpx; width: 12rpx; height: 6rpx; border-radius: 50%; background: rgba(235,137,128,.35); }.blush.left { left: 8rpx; }.blush.right { right: 8rpx; }
.character-name { margin-top: 16rpx; font-size: 30rpx; font-weight: 600; display: flex; justify-content: space-between; }.character-number { font: 20rpx serif; color: #b1b5a9; }
.character-title { font-size: 20rpx; color: #8b9186; margin-top: 5rpx; }
.mini-stats { display: flex; justify-content: space-between; border-top: 1rpx solid #ece9df; border-bottom: 1rpx solid #ece9df; margin: 14rpx 0 12rpx; padding: 10rpx 0; }.mini-stats view { display: flex; flex-direction: column; gap: 4rpx; font-size: 17rpx; color: #9a9d94; }.stat-value { font-size: 23rpx; font-weight: 600; color: #52675b; }
.trait { font-size: 17rpx; line-height: 1.5; color: #8c806f; min-height: 51rpx; }
.quote { text-align: center; color: #7f887d; font-family: "KaiTi", serif; font-size: 23rpx; margin: 34rpx 12rpx 26rpx; }.quote-mark { color: #b3a183; font-size: 34rpx; margin: 0 8rpx; }
.start-button { height: 98rpx; border-radius: 20rpx; background: #426a59; color: #fffdf4; display: flex; align-items: center; justify-content: center; gap: 30rpx; font-size: 29rpx; letter-spacing: 3rpx; box-shadow: 0 12rpx 30rpx rgba(56,94,75,.23); }.start-button.button-hover { background: #365c4c; }.arrow { font-size: 38rpx; font-weight: 300; }
.footer-note { text-align: center; margin-top: 25rpx; color: #a1a396; font-size: 19rpx; letter-spacing: 3rpx; }

/* 种子码 */
.seed-card { margin: 30rpx 0 16rpx; padding: 20rpx 22rpx; border: 1rpx solid rgba(112,139,116,.18); border-radius: 18rpx; background: rgba(255,255,250,.7); display: flex; align-items: center; box-shadow: 0 8rpx 30rpx rgba(60,83,63,.04); }
.seed-icon { width: 60rpx; height: 60rpx; border-radius: 12rpx; background: #f3e8d7; display: flex; align-items: center; justify-content: center; font: bold 28rpx "STKaiti", "KaiTi", serif; color: #a87b55; }
.seed-info { flex: 1; display: flex; flex-direction: column; margin-left: 18rpx; }
.seed-title { font-size: 24rpx; font-weight: 600; }
.seed-desc { margin-top: 6rpx; font-size: 19rpx; color: #8a9389; }
.seed-code { font: bold 34rpx "Courier New", monospace; letter-spacing: 6rpx; color: #4f715e; background: #f4f0e5; border-radius: 12rpx; padding: 12rpx 14rpx; }
.seed-form { display: flex; align-items: center; }
.seed-input { flex: 1; height: 76rpx; padding: 0 20rpx; border-radius: 14rpx; border: 1rpx solid rgba(112,139,116,.2); background: #fffdf4; font: bold 28rpx "Courier New", monospace; letter-spacing: 5rpx; color: #43564b; }
.seed-apply { margin-left: 14rpx; height: 76rpx; padding: 0 30rpx; border-radius: 14rpx; background: #4f715e; color: #fffdf1; font-size: 24rpx; line-height: 76rpx; }
.seed-hint { margin: 12rpx 0 0; font-size: 19rpx; color: #8a9389; }
